# Task B4 - Sentiment Analysis and Complaint Summarization

POSITIVE = ['good', 'clean', 'fast', 'helpful', 'improved']
NEGATIVE = ['bad', 'dirty', 'slow', 'rude', 'smoke', 'broken']
NEGATORS = ['not', 'never', 'no']


# Sentiment scoring
def score(text):
    words = text.lower().replace('.', '').replace(',', '').split()
    total = 0

    for i in range(len(words)):
        value = 0

        if words[i] in POSITIVE:
            value = 1
        elif words[i] in NEGATIVE:
            value = -1

        # Check whether the previous word is a negator
        if i > 0 and words[i - 1] in NEGATORS:
            value = -value

        total += value

    return total


# Sentiment labeling
def label(text):
    s = score(text)

    if s > 0:
        return "positive"
    elif s < 0:
        return "negative"
    else:
        return "neutral"


